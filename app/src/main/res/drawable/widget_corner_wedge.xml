<?xml version="1.0" encoding="utf-8"?>
<!-- 右上角撞色双三角：藏青大三角 + 东航红小三角。
     藏青三角的右缘向下延伸至 88（补上右下侧空缺）；视图高度留足 120，
     使绘制区远离 clipToOutline 对视图内角的圆角裁剪（系统挂件圆角只削真正的卡片右上角）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <path
        android:fillColor="#2B14284B"
        android:pathData="M24,0 L120,0 L120,88 Z" />
    <path
        android:fillColor="#33C8102E"
        android:pathData="M68,0 L120,0 L120,46 Z" />
</vector>
