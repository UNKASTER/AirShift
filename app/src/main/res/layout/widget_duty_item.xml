<?xml version="1.0" encoding="utf-8"?>
<!-- 当前执勤小组件：固定藏青板面（与 App 板头同色，浅深壁纸都可读）。
     自上而下：头行（执勤序号 · 类型 · 机号 · 机型，尾部省略 + VIP 灯）/
     hero 行（距到位倒计时 + 到位时间 + 描边"完成"）/ 板面行线 / 两行航段（夹条 · 进出 · 航班 · 对方机场 · 本站机位）。
     注意：launcher 对超出格子高度的内容做底部裁剪，总高约 205dp，与 duty_widget_info 的 targetCellHeight=3 配套。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_duty_item_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_board_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <!-- 整页提示：无排班 / 今日全部完成 -->
        <LinearLayout
            android:id="@+id/widget_message_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_message_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/duty_widget_preview_message_title"
                android:textColor="@color/on_board"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_message_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/duty_widget_preview_message_detail"
                android:textColor="@color/on_board_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 执勤页 -->
        <LinearLayout
            android:id="@+id/widget_duty_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- 1. 头行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/barlow_medium"
                    android:fontFeatureSettings="tnum"
                    android:singleLine="true"
                    android:text="@string/duty_widget_preview_header"
                    android:textColor="@color/on_board_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_vip"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/widget_vip_badge"
                    android:fontFamily="@font/barlow_bold"
                    android:gravity="center"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/duty_widget_vip"
                    android:textColor="@color/widget_vip_text"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 2. hero 行：距到位 + 到位时间 + 描边完成键 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_status_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duty_widget_status_countdown"
                        android:textColor="@color/on_board_secondary"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp">

                        <Chronometer
                            android:id="@+id/widget_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_semicondensed_bold"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:textColor="@color/on_board"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/widget_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/duty_widget_status_completed"
                            android:textColor="@color/widget_ok"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_due_column"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duty_widget_due_label"
                        android:textColor="@color/on_board_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/widget_gate_arrival"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/barlow_semicondensed_semibold"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:text="@string/duty_widget_preview_time"
                        android:textColor="@color/on_board"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_complete_duty"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/widget_complete_outline"
                    android:clickable="true"
                    android:contentDescription="@string/duty_widget_complete_content_description"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/duty_widget_complete"
                    android:textColor="@color/on_board"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. 板面行线（RemoteViews 不允许裸 View，用空 FrameLayout 画线）；无航段时由 renderer 隐藏 -->
            <FrameLayout
                android:id="@+id/widget_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/board_rule" />

            <!-- 4. 航段行：夹条 + 进/出 · 航班号 · 对方机场 · 本站机位 -->
            <LinearLayout
                android:id="@+id/widget_leg_primary"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_leg_primary_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:background="@drawable/widget_tag_inbound"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:text="@string/duty_widget_tag_in"
                    android:textColor="@color/widget_arrival"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_leg_primary_flight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/barlow_semicondensed_bold"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:minWidth="64dp"
                    android:text="@string/duty_widget_preview_flight_in"
                    android:textColor="@color/on_board"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/widget_leg_primary_place"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/duty_widget_preview_place"
                    android:textColor="@color/on_board_secondary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/duty_widget_stand_content_description"
                    android:src="@drawable/ic_widget_stand"
                    android:tint="@color/on_board_secondary" />

                <TextView
                    android:id="@+id/widget_leg_primary_stand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/barlow_semicondensed_semibold"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="@string/duty_widget_preview_stand"
                    android:textColor="@color/on_board"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_leg_secondary"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_leg_secondary_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:background="@drawable/widget_tag_outbound"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:text="@string/duty_widget_tag_out"
                    android:textColor="@color/widget_departure"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_leg_secondary_flight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/barlow_semicondensed_bold"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:minWidth="64dp"
                    android:text="@string/duty_widget_preview_flight_out"
                    android:textColor="@color/on_board"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/widget_leg_secondary_place"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/duty_widget_preview_place"
                    android:textColor="@color/on_board_secondary"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/duty_widget_stand_content_description"
                    android:src="@drawable/ic_widget_stand"
                    android:tint="@color/on_board_secondary" />

                <TextView
                    android:id="@+id/widget_leg_secondary_stand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/barlow_semicondensed_semibold"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="@string/duty_widget_preview_stand"
                    android:textColor="@color/on_board"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
